prebuilt_etc {
    name: "privapp-com.oplus.oreality.audio.xml",
    src: "permissions/privapp-com.oplus.oreality.audio.xml",
    sub_dir: "permissions",
}

prebuilt_etc {
    name: "config-com.oplus.oreality.audio.xml",
    src: "permissions/config-com.oplus.oreality.audio.xml",
    sub_dir: "sysconfig",
}

prebuilt_etc {
    name: "oplus.software.audio.audioeffect_support.xml",
    src: "permissions/oplus.software.audio.audioeffect_support.xml",
    sub_dir: "permissions",
}

prebuilt_etc {
    name: "oplus.software.audio.audiox_support.xml",
    src: "permissions/oplus.software.audio.audiox_support.xml",
    sub_dir: "permissions",
}

cc_prebuilt_library_shared {
    name: "liboplus_audiox",
    owner: "oneplus",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["proprietary/odm/lib64/liboplus_audiox.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    device_specific: true,
}

cc_prebuilt_library_shared {
    name: "liboppo_audiox",
    owner: "oneplus",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["proprietary/odm/lib64/liboppo_audiox.so"],
        },
    },
    compile_multilib: "64",
    check_elf_files: false,
    device_specific: true,
}

cc_prebuilt_library_shared {
    name: "libOplusAudioxAidl",
    owner: "oneplus",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["proprietary/odm/lib64/soundfx/libOplusAudioxAidl.so"],
        },
    },
    relative_install_path: "soundfx",
    compile_multilib: "64",
    check_elf_files: false,
    device_specific: true,
}

cc_prebuilt_library_shared {
    name: "liboppo_audiox_sw_effects",
    owner: "oneplus",
    strip: {
        none: true,
    },
    target: {
        android_arm64: {
            srcs: ["proprietary/odm/lib64/soundfx/liboppo_audiox_sw_effects.so"],
        },
    },
    relative_install_path: "soundfx",
    compile_multilib: "64",
    check_elf_files: false,
    device_specific: true,
}
